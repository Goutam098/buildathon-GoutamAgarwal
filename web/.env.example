# Copy to .env.local and fill in. .env.local is gitignored and never committed.
# The key is read server-side only, inside the Next.js route handlers.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# Either provider works. Anthropic is used when both are present.
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o
